# Infrastructure Configuration - Single Source of Truth
# Source this file in all shell scripts: source "$(dirname "$0")/../config.env"

# HAProxy Configuration
export HAPROXY_HOST="localhost"
export HAPROXY_HTTP_PORT=18082
export HAPROXY_STATS_PORT=18404
export HAPROXY_SOCKET_PORT=19999

# Derived HAProxy URLs
export HAPROXY_URL="http://${HAPROXY_HOST}:${HAPROXY_HTTP_PORT}"
export HAPROXY_STATS_URL="http://${HAPROXY_HOST}:${HAPROXY_STATS_PORT}/stats"
export HAPROXY_STATS_CSV_URL="http://${HAPROXY_HOST}:${HAPROXY_STATS_PORT}/stats;csv"

# Kubernetes NodePorts
export K3S_WARM_NODEPORT=30080
export K3S_ACTIVATOR_NODEPORT=30081

# Prometheus
export PROMETHEUS_HOST="localhost"
export PROMETHEUS_PORT=9090
export PROMETHEUS_URL="http://${PROMETHEUS_HOST}:${PROMETHEUS_PORT}"

# GRU Prediction Service
export GRU_HOST="localhost"
export GRU_PORT=8090
export GRU_URL="http://${GRU_HOST}:${GRU_PORT}"

# Routing Daemon
export DAEMON_API_PORT=9104
export DAEMON_URL="http://localhost:${DAEMON_API_PORT}"

# K3d Node IP (auto-detected or fallback)
export K3D_NODE_IP="${K3D_NODE_IP:-127.0.0.1}"

# Compute full backend URLs
export K3S_WARM_URL="http://${K3D_NODE_IP}:${K3S_WARM_NODEPORT}"
export K3S_ACTIVATOR_URL="http://${K3D_NODE_IP}:${K3S_ACTIVATOR_NODEPORT}"
