# IDE
.idea/
.vscode/
*.swp
*.swo
.ropeproject/

# Data files (large)
data/raw/**/*.gz
data/raw/**/*.tar
data/raw/**/*.log
*.parquet

# Results raw data (keep tables/figures)
results/raw/**/*.json
results/raw/**/*.csv

# ML artifacts
*.joblib
*.pkl
*.h5
*.pt
*.pth
controller/prediction/**/*.onnx

# Load testing (outside bundles)
results/load-tests/*.json
k6/summary/*.json

# Large raw JSON blobs only — bundle-level JSON (result.json, paired_analysis.json,
# k6-summary.json) stays TRACKED in plain git as evidence-critical artifacts
results/experiments/**/raw/*.json
results/experiments/**/raw/**/k6-results.json
!results/experiments/**/raw/**/k6-summary.json
!results/experiments/**/raw/**/daemon-pre.json
!results/experiments/**/raw/**/daemon-post.json
# Derived per-run exports (prometheus scrape, k6 dump) — regenerable, LFS/disk tier
results/experiments/**/prometheus/*.json
results/experiments/**/k6/*.json

# Legacy stress test output (not a formal results bundle)
results/stress-test-output/
# Evidence catalog — local DuckDB cache, rebuilt not committed
results/evidence/catalog.duckdb
results/evidence/catalog.duckdb.wal
results/evidence/catalog.duckdb.tmp

# OS
.DS_Store
Thumbs.db

# Secrets
.env
.env.local
*.pem
*.key

# Embedded git repos in archived (avoid submodule issues)
archived/autoscaler-experiments/experiment-6-odhi-scaler/original-source/
archived/references/infras-app-deploy-monitoring/tutorials/

# Generated artifacts
*.db
*.sqlite*
*.coverage
.coverage
__pycache__/
.pytest_cache/
*.pyc

# Beads / Dolt files (added by bd init)
.dolt/
.beads-credential-key
# Typst thesis build artifacts
thesis-typst/build/
thesis-typst/.typst-cache/
**/.typst-cache/
*.pdf
!docs/references/*.pdf
!thesis-typst/build/.gitkeep
*.docx

# Agent tooling + regenerable local artifacts (not thesis data)
graphify-out/
.pi/
.claude/
.beads/metadata.json

# Legacy stress-test raw k6 blobs (regenerable raw dumps; summaries stay tracked)
infrastructure/results/**/results.json
infrastructure/results/**/k6-results.json
